# Shared member-phone password. Compared server-side with a timing-safe HMAC.
# Never commit a real value. Production is set in Vercel only.
# MEMBER_PASSWORD=
# Catalogue tab of NiaSave-Backend-Data-Sheets. Default is the live workbook.
# NIASAVE_CATALOGUE_SHEET_ID=1ziaBVmk85RVW5SpvLnPD9o6q2s2IR9mcrYCxRm2TzmA
BLOB_READ_WRITE_TOKEN=

# Add provider variables only when the integration code uses them.
# Keep all real values in Vercel environment variables, never in GitHub or this file.
# OTP_PROVIDER=
# OTP_API_KEY=
# Temporary Central-member gate on identity OTP. Unset or false: testers can
# request OTP without Central enrolment. Set true (+ redeploy) to restore
# not_registered fail-closed.
# COMMERCE_REQUIRE_CENTRAL_MEMBER=
# Temporary Central-identity gate on GET /api/commerce/identity. Unset or
# false: unknown_request / missing enrolment return status unavailable
# (never invent member/studio/JCO). Set true (+ redeploy) to fail closed.
# COMMERCE_REQUIRE_CENTRAL_IDENTITY=
# Guest Save/shop browse without a session. Unset or true: unsigned catalogue
# returns published SKUs. Set false to restore the empty sign_in_required wall.
# COMMERCE_PUBLIC_BROWSE=
# UPI_PROVIDER=
# UPI_KEY_ID=
# UPI_KEY_SECRET=
# UPI_WEBHOOK_SECRET=
