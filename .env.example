STAFF_TOKEN_SECRET=
# Documented default is on. Set the same value on the live Vercel project; this file is not applied automatically.
STAFF_AUTH_REQUIRED=1
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

