{
  "installCommand": "npm install",
  "buildCommand": "sh vercel-build.sh",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/polo.html", "destination": "/ops.html", "permanent": false },
    { "source": "/polo", "destination": "/ops.html", "permanent": false }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{api,rabbit,bison,lib}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/research/why-blue-collar-workers-quit", "destination": "/research/why-blue-collar-workers-quit.html" },
    { "source": "/research/why-blue-collar-workers-quit/", "destination": "/research/why-blue-collar-workers-quit.html" },
    { "source": "/health", "destination": "/api?path=health" },
    { "source": "/v1/:path*", "destination": "/api?path=v1/:path*" },
    { "source": "/api/:path*", "destination": "/api?path=:path*" }
  ],
  "headers": [
    {
      "source": "/ops.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/bison.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/bison-data.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/bison-data.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/staff.css",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/staff.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/bison.css",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/bison.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/research/why-blue-collar-workers-quit",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/research/why-blue-collar-workers-quit/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/research/why-blue-collar-workers-quit.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ],
  "crons": [{ "path": "/api/bison/data/sync", "schedule": "*/15 * * * *" }]
}
