{
  "installCommand": "npm install",
  "buildCommand": "sh vercel-build.sh",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/polo.html",
      "destination": "/ops.html",
      "permanent": false
    },
    {
      "source": "/polo",
      "destination": "/ops.html",
      "permanent": false
    },
    {
      "source": "/member.html",
      "destination": "/#account",
      "permanent": false
    },
    {
      "source": "/member-services.html",
      "destination": "/#account",
      "permanent": false
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{api,rabbit,bison,lib}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/research/why-blue-collar-workers-quit",
      "destination": "/research/why-blue-collar-workers-quit.html"
    },
    {
      "source": "/research/why-blue-collar-workers-quit/",
      "destination": "/research/why-blue-collar-workers-quit.html"
    },
    {
      "source": "/health",
      "destination": "/api?path=health"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api?path=v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/tanot/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/bison-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/staff.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/staff.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/bison.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/bison.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/research/why-blue-collar-workers-quit",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/research/why-blue-collar-workers-quit/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/research/why-blue-collar-workers-quit.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/commerce(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/bison/data/sync",
      "schedule": "*/15 * * * *"
    }
  ]
}
